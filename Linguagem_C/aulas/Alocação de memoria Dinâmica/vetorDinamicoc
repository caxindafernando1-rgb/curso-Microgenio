#include <stdio.h>
#include <locale.h>
#include <windows.h>  
#include <string.h>
#include <time.h>

/*
                                                                        Vetor Dinâmico
*/

int main (){

   SetConsoleOutputCP(CP_UTF8);
   SetConsoleCP(CP_UTF8);
   setlocale(LC_ALL, ".UTF8");


   srand(time(NULL));
   int *vet, tam, i;

   printf("Digite o tamanho do vetor: ");
   scanf("%d", &tam);

   vet = malloc(tam * sizeof(int));

   if(vet)
    printf("\n\nVetor de tamanho %d criando com sucesso!: ", tam);
    for (i = 0; i < tam; i++){
        *(vet + i) = 1 + rand() % 100;
    }
    for ( i = 0; i < tam; i++){
        printf("%d ", *(vet + i));
    }
    printf("\n\n");
   else
        printf("\n\nFalha ao criar vetor\n\n");
    
   return 0;
}
